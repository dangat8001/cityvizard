---
---
<div class="layout">
  <div id="map"></div>
  <aside class="panel">
    <section class="panel-section">
      <h2>Ciclorutas · tipo de superficie</h2>
      <div id="surface-filters"></div>
    </section>

    <section class="panel-section">
      <h2>Población por UPZ</h2>
      <label class="toggle-3d">
        <input type="checkbox" id="pop-toggle" />
        Mostrar en el mapa (3D)
      </label>

      <div class="table-controls">
        <label for="top-n-select">Mostrar</label>
        <select id="top-n-select">
          <option value="10">Top 10 más pobladas</option>
          <option value="25" selected>Top 25 más pobladas</option>
          <option value="50">Top 50 más pobladas</option>
          <option value="all">Todas (112)</option>
        </select>
      </div>

      <div class="table-wrap">
        <table id="upz-table">
          <thead>
            <tr>
              <th>UPZ</th>
              <th>Población</th>
              <th>Densidad<br />(hab/ha)</th>
            </tr>
          </thead>
          <tbody id="upz-table-body"></tbody>
        </table>
      </div>
      <small>Proyección 2026 (SDP) · color de la columna = densidad · clic en
        una fila para ubicarla en el mapa</small>
    </section>
  </aside>
</div>

<style>
  .layout {
    position: absolute;
    inset: 0;
    display: flex;
  }

  #map {
    flex: 0 0 65%;
    min-width: 0;
    position: relative;
  }

  .panel {
    flex: 1 1 35%;
    min-width: 280px;
    overflow-y: auto;
    background: #fff;
    border-left: 1px solid rgba(0, 0, 0, 0.12);
    font: 14px/1.4 system-ui, sans-serif;
    padding: 1rem;
    box-sizing: border-box;
  }

  .panel-section {
    margin-bottom: 1.5rem;
  }

  .panel-section h2 {
    margin: 0 0 0.6rem;
    font-size: 15px;
  }

  .panel-section label {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    margin: 0.2rem 0;
    cursor: pointer;
  }

  .toggle-3d {
    margin-bottom: 0.75rem !important;
    font-weight: 600;
  }

  .table-controls {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 0.6rem;
  }

  .table-controls select {
    flex: 1;
    padding: 0.25rem;
  }

  .table-wrap {
    max-height: 50vh;
    overflow-y: auto;
    border: 1px solid rgba(0, 0, 0, 0.12);
    border-radius: 0.4rem;
  }

  #upz-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 13px;
  }

  #upz-table th {
    position: sticky;
    top: 0;
    background: #f3f3f1;
    text-align: left;
    padding: 0.4rem 0.5rem;
    border-bottom: 1px solid rgba(0, 0, 0, 0.12);
  }

  #upz-table td {
    padding: 0.35rem 0.5rem;
    border-bottom: 1px solid rgba(0, 0, 0, 0.06);
  }

  #upz-table tbody tr {
    cursor: pointer;
  }

  #upz-table tbody tr:hover {
    background: rgba(0, 0, 0, 0.04);
  }

  .panel-section small {
    display: block;
    margin-top: 0.5rem;
    color: #555;
  }
</style>

<script>
  import { Map as MapLibreMap, NavigationControl, setWorkerUrl } from "maplibre-gl";
  // Vite no emite el worker de maplibre-gl por su ruta esperada; hay que
  // importarlo explícitamente y registrar su URL antes de crear el mapa.
  // https://github.com/maplibre/maplibre-gl-js/issues (Vite + worker bundling)
  import maplibreWorkerUrl from "maplibre-gl/dist/maplibre-gl-worker.mjs?url";
  import "maplibre-gl/dist/maplibre-gl.css";
  import { buildSurfaceFilter, uniqueSurfaceTypes } from "../lib/filters.js";
  import { roughCentroid } from "../lib/geo.js";
  import {
    buildExtrusionColorExpression,
    buildExtrusionHeightExpression,
    buildUpzFilter,
    interpolateDensityColor,
    topNFeatures,
  } from "../lib/population.js";

  setWorkerUrl(maplibreWorkerUrl);

  const BOGOTA_CENTER = [-74.08, 4.65];
  // OpenFreeMap: tiles vectoriales gratuitos, sin API key ni límites de uso.
  // "positron" es un estilo minimalista en gris/beige (sin azules de agua ni
  // verdes de parques) pensado para resaltar datos propios superpuestos.
  // https://openfreemap.org
  const BASEMAP_STYLE = "https://tiles.openfreemap.org/styles/positron";

  const CICLORUTAS_COLOR = "#ea580c"; // naranja, no se confunde con nada del basemap
  const CICLORUTAS_LAYERS = ["ciclorutas-fill", "ciclorutas-line"];

  const map = new MapLibreMap({
    container: "map",
    center: BOGOTA_CENTER,
    zoom: 11,
    style: BASEMAP_STYLE,
  });

  map.addControl(new NavigationControl(), "top-left");

  map.on("load", async () => {
    const response = await fetch("/data/ciclorutas.geojson");
    const geojson = await response.json();

    map.addSource("ciclorutas", { type: "geojson", data: geojson });
    map.addLayer({
      id: "ciclorutas-fill",
      type: "fill",
      source: "ciclorutas",
      paint: { "fill-color": CICLORUTAS_COLOR, "fill-opacity": 0.35 },
    });
    // Capa de línea con ancho fijo en píxeles: sin esto, los polígonos
    // (delgados en la realidad) casi no se ven a escala de ciudad.
    map.addLayer({
      id: "ciclorutas-line",
      type: "line",
      source: "ciclorutas",
      paint: {
        "line-color": CICLORUTAS_COLOR,
        "line-width": ["interpolate", ["linear"], ["zoom"], 10, 1, 16, 3],
      },
    });

    const surfaceTypes = uniqueSurfaceTypes(geojson.features);
    const selected = new Set(surfaceTypes);
    const surfaceFilters = document.getElementById("surface-filters");

    for (const type of surfaceTypes) {
      const label = document.createElement("label");
      const checkbox = document.createElement("input");
      checkbox.type = "checkbox";
      checkbox.checked = true;
      checkbox.addEventListener("change", () => {
        if (checkbox.checked) {
          selected.add(type);
        } else {
          selected.delete(type);
        }
        const filter = buildSurfaceFilter([...selected]);
        for (const layerId of CICLORUTAS_LAYERS) {
          map.setFilter(layerId, filter);
        }
      });
      label.append(checkbox, document.createTextNode(type));
      surfaceFilters.append(label);
    }

    const popResponse = await fetch("/data/poblacion_upz.geojson");
    const popGeojson = await popResponse.json();
    const allFeatures = popGeojson.features;
    const densityValues = allFeatures
      .map((f) => f.properties.densidad_hab_ha)
      .filter((v) => typeof v === "number");
    const densityMin = Math.min(...densityValues);
    const densityMax = Math.max(...densityValues);

    map.addSource("poblacion-upz", { type: "geojson", data: popGeojson });
    map.addLayer({
      id: "poblacion-upz-3d",
      type: "fill-extrusion",
      source: "poblacion-upz",
      layout: { visibility: "none" },
      paint: {
        "fill-extrusion-height": buildExtrusionHeightExpression(allFeatures),
        "fill-extrusion-color": buildExtrusionColorExpression(allFeatures),
        "fill-extrusion-opacity": 0.85,
      },
    });
    // Resalta una única UPZ al hacer clic en una fila de la tabla.
    map.addLayer({
      id: "poblacion-upz-highlight",
      type: "line",
      source: "poblacion-upz",
      layout: { visibility: "none" },
      filter: ["==", ["get", "codigo_upz"], "__none__"],
      paint: { "line-color": "#111827", "line-width": 3 },
    });

    const popToggle = document.getElementById("pop-toggle");
    const topNSelect = document.getElementById("top-n-select");
    const tableBody = document.getElementById("upz-table-body");

    function applyTopNFilter(features) {
      const codes = features.map((f) => f.properties.codigo_upz);
      map.setFilter("poblacion-upz-3d", buildUpzFilter(codes));
    }

    function renderTable(features) {
      tableBody.innerHTML = "";
      for (const feature of features) {
        const { codigo_upz, nombre, poblacion_total, densidad_hab_ha } = feature.properties;
        const row = document.createElement("tr");
        row.innerHTML = `
          <td>${nombre}</td>
          <td>${poblacion_total.toLocaleString("es-CO")}</td>
          <td style="background-color:${interpolateDensityColor(densidad_hab_ha, densityMin, densityMax)}">
            ${densidad_hab_ha.toFixed(1)}
          </td>
        `;
        row.addEventListener("click", () => {
          map.setLayoutProperty("poblacion-upz-highlight", "visibility", "visible");
          map.setFilter("poblacion-upz-highlight", ["==", ["get", "codigo_upz"], codigo_upz]);
          const center = roughCentroid(feature.geometry);
          if (center) {
            map.flyTo({ center, zoom: 13 });
          }
        });
        tableBody.append(row);
      }
    }

    function refresh() {
      const visible = topNFeatures(allFeatures, topNSelect.value);
      renderTable(visible);
      applyTopNFilter(visible);
    }

    topNSelect.addEventListener("change", refresh);
    popToggle.addEventListener("change", () => {
      const visibility = popToggle.checked ? "visible" : "none";
      map.setLayoutProperty("poblacion-upz-3d", "visibility", visibility);
      map.easeTo({ pitch: popToggle.checked ? 45 : 0, duration: 500 });
    });

    refresh();
  });
</script>
